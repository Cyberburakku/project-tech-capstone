# Supabase project settings (Project Settings → API).
# Both are safe to expose in the browser; Row Level Security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: turn on "Ask Second Take" AI chat (requires the second-take Edge Function).
VITE_SECOND_TAKE_AI=false
